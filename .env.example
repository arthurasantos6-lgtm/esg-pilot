NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Somente no servidor (nunca use o prefixo NEXT_PUBLIC_ nestas chaves) ---
# Copiloto e avaliação ESG por IA. Sem estas duas chaves, a plataforma funciona
# sem IA: ideias são registradas, revisadas e enviadas normalmente.
ANTHROPIC_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: modelo da Claude usado pelo copiloto (padrão: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

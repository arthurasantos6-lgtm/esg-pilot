NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Somente no servidor (nunca use o prefixo NEXT_PUBLIC_ nestas chaves) ---
# Necessária para os recursos de IA (grava respostas do copiloto e avaliações).
SUPABASE_SERVICE_ROLE_KEY=

# --- Provedor de IA: escolha UMA opção. Sem nenhuma, a plataforma funciona sem IA. ---

# Opção gratuita e local: Ollama (https://ollama.com), roda no seu computador.
# AI_PROVIDER=ollama
# AI_MODEL=qwen2.5:7b

# Opção gratuita com limites: Google Gemini (chave em https://aistudio.google.com/apikey).
# Atenção: na camada gratuita o conteúdo pode ser usado pelo Google; use dados fictícios.
# AI_PROVIDER=gemini
# AI_MODEL=<modelo listado no Google AI Studio>
# AI_API_KEY=

# Opção gratuita com limites: Groq (chave em https://console.groq.com/keys).
# AI_PROVIDER=groq
# AI_MODEL=<modelo listado no console da Groq>
# AI_API_KEY=

# Opção paga: Anthropic Claude (chave em https://console.anthropic.com).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

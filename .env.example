NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Somente no servidor (nunca use o prefixo NEXT_PUBLIC_ nestas chaves) ---
# Necessária para os recursos de IA (grava respostas do copiloto e avaliações).
SUPABASE_SERVICE_ROLE_KEY=

# --- Pesquisa de mercado gratuita (sem IA): chave da Tavily, plano grátis de 1.000 buscas/mês,
# sem cartão (https://tavily.com). Cada pesquisa de ideia usa de 4 a 6 buscas. ---
# TAVILY_API_KEY=

# --- Transcrição de áudio pela Groq (Whisper), independente da IA externa. Plano gratuito com
# limites; chave em https://console.groq.com/keys. Sem esta variável, o áudio é transcrito no
# próprio aparelho do colaborador. Se a Groq falhar, o aparelho assume. ---
# GROQ_API_KEY=
# Opcional: modelo de transcrição (padrão: whisper-large-v3-turbo).
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# --- IA externa: opcional e desligada por padrão. O fluxo principal usa o motor local e a
# transcrição no aparelho. Só com ESG_EXTERNAL_AI=true os provedores abaixo são usados. ---
# ESG_EXTERNAL_AI=true

# --- Provedor de IA: escolha UMA opção. ---

# Opção gratuita e local: Ollama (https://ollama.com), roda no seu computador.
# AI_PROVIDER=ollama
# AI_MODEL=qwen2.5:7b

# Opção gratuita com limites: Google Gemini (chave em https://aistudio.google.com/apikey).
# Atenção: na camada gratuita o conteúdo pode ser usado pelo Google; use dados fictícios.
# AI_PROVIDER=gemini
# AI_MODEL=<modelo de conversa listado no Google AI Studio>
# AI_API_KEY=
# Opcional: modelo para transcrever áudio. Se faltar ou falhar, usa AI_MODEL.
# AI_TRANSCRIPTION_MODEL=

# Opção gratuita com limites: Groq (chave em https://console.groq.com/keys).
# AI_PROVIDER=groq
# AI_MODEL=llama-3.3-70b-versatile
# AI_API_KEY=
# Opcional: transcrição de áudio. Sem esta variável, usa whisper-large-v3-turbo.
# AI_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Opção paga: Anthropic Claude (chave em https://console.anthropic.com).
# Também oferece pesquisa na internet com IA, usada só quando não há TAVILY_API_KEY.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
